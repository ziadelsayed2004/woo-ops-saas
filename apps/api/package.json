{
  "name": "@woo-ops/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test:unit": "tsx --test tests/unit/*.test.js",
    "test:e2e": "node --test tests/*.e2e.test.js",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db-cli.ts migrate",
    "db:backup": "tsx src/db-cli.ts backup",
    "db:restore": "tsx src/db-cli.ts restore",
    "db:maintenance": "tsx src/db-cli.ts maintenance",
    "db:list": "tsx src/db-cli.ts list",
    "test:integration": "tsx --test tests/*.integration.test.js",
    "test:security": "tsx --test tests/*security*.integration.test.js",
    "test:tenant-isolation": "tsx --test tests/tenant-isolation.integration.test.js"
  },
  "dependencies": {
    "@woo-ops/application": "0.1.0",
    "@woo-ops/contracts": "0.1.0",
    "@woo-ops/connectors": "0.1.0",
    "@woo-ops/documents": "0.1.0",
    "@woo-ops/exports": "0.1.0",
    "@woo-ops/persistence": "0.1.0",
    "@types/express": "^5.0.3",
    "express": "^5.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "tsx": "^4.20.5"
  }
}

{
  "name": "@woo-ops/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node --test",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db-cli.ts migrate",
    "db:backup": "tsx src/db-cli.ts backup"
  },
  "dependencies": {
    "@woo-ops/contracts": "workspace:*",
    "@woo-ops/persistence": "workspace:*",
    "express": "^5.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "tsx": "^4.20.5"
  }
}

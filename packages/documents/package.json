    "test:golden": "node --test tests/*.test.js",
    "test:visual": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "22.0.0",
    "@types/qrcode": "1.5.5",
    "bwip-js": "4.5.1",
    "pdf-lib": "1.17.1",
    "playwright-chromium": "^1.63.0",
    "qrcode": "1.5.4"
  }
}

# Runtime
NODE_ENV=development
APP_PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000
API_PORT=3000
WORKER_CONCURRENCY=4
LOG_LEVEL=info

# Authentication
SESSION_SECRET=replace-with-at-least-32-random-bytes
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Managed MongoDB Atlas in staging/production
MONGODB_URI=mongodb://localhost:27017/woo_ops_saas
MONGODB_DB_NAME=woo_ops_saas

# Managed Redis in staging/production
REDIS_URL=redis://localhost:6379

# S3-compatible object storage
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=woo-ops-local
OBJECT_STORAGE_ACCESS_KEY=local-access-key
OBJECT_STORAGE_SECRET_KEY=local-secret-key
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Email provider
EMAIL_FROM=no-reply@example.test
EMAIL_PROVIDER_API_KEY=replace-me

# Optional observability
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# Webhook safety
WEBHOOK_PUBLIC_BASE_URL=http://localhost:3000
WEBHOOK_REPLAY_WINDOW_SECONDS=300

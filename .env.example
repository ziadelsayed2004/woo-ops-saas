# Runtime
NODE_ENV=development
PORT=3000
WOO_OPS_DATA_DIR=./data
WOO_OPS_DATABASE=./data/woo-ops.sqlite
WOO_OPS_BACKUP_RETENTION=7
WEB_PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000
LOG_LEVEL=info

# Authentication
SESSION_SECRET=replace-with-at-least-32-random-bytes
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Production uses the same HTTPS origin for WEB_PUBLIC_URL and API_PUBLIC_URL.
# WooCommerce read-only API keys are received through the authorization callback and encrypted.
# Optional signed Woo order webhooks use a unique configured secret per connection.

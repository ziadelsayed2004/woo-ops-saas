# Runtime
NODE_ENV=development
PORT=3000
# Optional local-only bind override: WOO_OPS_BIND_HOST=127.0.0.1 (leave unset on Hostinger).
# Local defaults. In Hostinger production, omit these two values to let Woo Ops use the stable
# domain-level .woo-ops-data directory, or set absolute paths outside hbuilds/public_html.
WOO_OPS_DATA_DIR=./data
WOO_OPS_DATABASE=./data/woo-ops.sqlite
WOO_OPS_BACKUP_RETENTION=7
# Automatic read-only Woo refresh cadence. New and changed orders are polled every 60 seconds.
# Catalog, variations, stock and shipping remain on the broader 15-minute refresh; a full
# reconciliation also detects remote deletions every 24 hours.
WOO_OPS_ORDER_SYNC_INTERVAL_SECONDS=60
WOO_OPS_SYNC_INTERVAL_MINUTES=15
WOO_OPS_RECONCILE_INTERVAL_HOURS=24
WEB_PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000
LOG_LEVEL=info
# Manual-order shipping quotes in integer EGP minor units (piastres), keyed by the exact governorate label.
WOO_OPS_EGYPT_SHIPPING_RATES_JSON={"Cairo":"6500","Giza":"6500","Alexandria":"7500"}

# Authentication
SESSION_SECRET=replace-with-at-least-32-random-bytes
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Production uses the same HTTPS origin for WEB_PUBLIC_URL and API_PUBLIC_URL.
# WooCommerce read-only API keys are received through the authorization callback and encrypted.
# Optional signed Woo order webhooks use a unique configured secret per connection.

{
  "name": "woo-ops-saas",
  "version": "0.0.0",
  "private": true,
  "description": "Woo Ops: a deployable WooCommerce order operations application",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "agent:doctor": "node .agentpack/scripts/agentpack.mjs doctor",
    "agent:validate": "node .agentpack/scripts/agentpack.mjs validate",
    "task:list": "node .agentpack/scripts/agentpack.mjs task list",
    "task:next": "node .agentpack/scripts/agentpack.mjs task next",
    "task:show": "node .agentpack/scripts/agentpack.mjs task show",
    "task:start": "node .agentpack/scripts/agentpack.mjs task start",
    "task:complete": "node .agentpack/scripts/agentpack.mjs task complete",
    "task:fail": "node .agentpack/scripts/agentpack.mjs task fail",
    "worktree:list": "node .agentpack/scripts/agentpack.mjs worktree list",
    "worktree:prune": "node .agentpack/scripts/agentpack.mjs worktree prune",
    "dev": "pnpm --parallel --filter @woo-ops/api --filter @woo-ops/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,json,html}\" \"packages/**/*.{ts,json}\" package.json tsconfig.base.json",
    "test:unit": "pnpm -r test:unit",
    "db:migrate": "pnpm --filter @woo-ops/api db:migrate",
    "db:backup": "pnpm --filter @woo-ops/api db:backup"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@10.15.0"
}
